# MindLab normalization (scoped)
* text=auto

# PowerShell: CRLF on checkout to avoid LF/CRLF churn on Windows
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Scripts that should remain LF (optional; keep minimal)
*.sh text eol=lf

# Common binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.js text eol=lf
*.cjs text eol=lf
*.yml text eol=lf
